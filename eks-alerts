                    uid: __expr__
                expression: A
                intervalMs: 1000
                maxDataPoints: 43200
                refId: C
                type: threshold
          noDataState: Alerting
          execErrState: Alerting
          for: 1m
          annotations:
            description: 'condition=Available, status=false metriği 5 dk kesintisiz 1 olan deployment sayısı > 0 olduğunda tetiklenir. Kaynak: eks2 dashboard "Unhealthy" paneli (id 64).'
            summary: 'EKS PROD: {{ $values.A.Value }} deployment 5 dk+ süredir Available değil (servis erişilemez olabilir).'
          labels:
            cluster: eks-prod
            severity: critical
            team: sre
          isPaused: false
