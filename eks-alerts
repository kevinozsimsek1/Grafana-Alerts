            summary: 'EKS PROD: {{ $values.A.Value }} PVC 5 dk+ süredir Pending (volume bağlanamıyor — storage class / provisioner / kota kontrol et).'
          labels:
            cluster: eks-prod
            severity: warning
            team: sre
          isPaused: false
          notification_settings:
            receiver: SRE System Alerts - Warning
        - uid: bfuypbyxtxm9sd
          title: EKS PROD - Failed Pods
          condition: C
          data:
