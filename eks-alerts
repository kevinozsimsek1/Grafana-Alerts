            summary: 'EKS PROD: {{ $values.A.Value }} container ImagePullBackOff/ErrImagePull durumunda (muhtemelen hatalı imaj/tag veya registry auth).'
          labels:
            cluster: eks-prod
            severity: critical
            team: sre
          isPaused: false
        - uid: cfuynyi182nlsb
          title: EKS PROD - OOMKilled
          condition: C
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: afl5b2ub9alfke
              model:
                editorMode: code
                expr: |-
                    count(
                      (
                        max by (namespace, pod, container) (
                          increase(kube_pod_container_status_restarts_total[5m])
                        ) > 0
                      )
                      and on(namespace, pod, container) (
                        max by (namespace, pod, container) (
                          kube_pod_container_status_last_terminated_reason{reason="OOMKilled"}
                        ) == 1
                      )
                    ) or vector(0)
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
            - refId: C
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: __expr__
              model:
                conditions:
                    - evaluator:
                        params:
                            - 0
                        type: gt
                      operator:
                        type: and
                      query:
                        params:
                            - C
                      reducer:
                        params: []
                        type: last
                      type: query
                datasource:
                    type: __expr__
                    uid: __expr__
                expression: A
                intervalMs: 1000
                maxDataPoints: 43200
                refId: C
                type: threshold
          noDataState: Alerting
          execErrState: Alerting
          for: 1m
          annotations:
            description: 'Son 5 dk içinde restart sayacı artmış VE son termination sebebi OOMKilled olan container sayısı > 0 olduğunda tetiklenir. Kaynak: eks2 dashboard "OOMKilled" paneli (id 60).'
            summary: 'EKS PROD: son 5 dk içinde {{ $values.A.Value }} container OOMKilled ile restart oldu (memory limit yetersiz olabilir).'
          labels:
            cluster: eks-prod
            severity: critical
            team: sre
          isPaused: false
          notification_settings:
            receiver: SRE System Alerts - Critical
