apiVersion: 1
groups:
    - orgId: 3
      name: eks-prod-cluster
      folder: Alert-rules
      interval: 1m
      rules:
        - uid: efuy83q5lem0we
          title: EKS PROD - Node NotReady
          condition: C
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: afl5b2ub9alfke
              model:
                editorMode: code
                expr: |-
                    count(kube_node_info{service="obs-kube-state-metrics"})
                      -
                    sum(kube_node_status_condition{service="obs-kube-state-metrics",condition="Ready",status="true"})
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
            - refId: C
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: __expr__
              model:
                conditions:
                    - evaluator:
                        params:
                            - 0
                        type: gt
                      operator:
                        type: and
                      query:
                        params:
                            - C
                      reducer:
                        params: []
                        type: last
                      type: query
                datasource:
                    type: __expr__
                    uid: __expr__
                expression: A
                intervalMs: 1000
                maxDataPoints: 43200
                refId: C
                type: threshold
          noDataState: Alerting
          execErrState: Alerting
          for: 5m
          annotations:
            description: 'total node ≠ ready node olduğunda tetiklenir (en az bir node Ready değil). Kaynak paneller: EKS dashboard "Total Nodes" (id 1) ve "Ready Nodes" (id 2).'
            summary: 'EKS PROD: en az bir node NotReady durumda (not-ready node sayısı: {{ $values.A.Value }}).'
          labels:
            severity: critical
            stack: eks-prod
          isPaused: false
        - uid: afuy21sdfrabkf
          title: Deployment Down - Zero Available Replicas
          condition: C
          data:
            - refId: A
              relativeTimeRange:
                from: 3600
                to: 0
              datasourceUid: afl5b2ub9alfke
              model:
                datasource:
                    type: prometheus
                    uid: afl5b2ub9alfke
                editorMode: code
                expr: count((kube_deployment_spec_replicas{namespace=~".*", service="obs-kube-state-metrics"} > 0) and (kube_deployment_status_replicas_available{namespace=~".*", service="obs-kube-state-metrics"} == 0)) or vector(0)
                instant: false
                interval: ""
                intervalMs: 15000
                legendFormat: Down
                maxDataPoints: 43200
                range: true
                refId: A
            - refId: B
              relativeTimeRange:
                from: 3600
                to: 0
              datasourceUid: __expr__
              model:
                conditions:
                    - evaluator:
                        params: []
                        type: gt
                      operator:
                        type: and
                      query:
                        params:
                            - B
                      reducer:
                        params: []
                        type: last
                      type: query
                datasource:
                    type: __expr__
                    uid: __expr__
                expression: A
                intervalMs: 1000
                maxDataPoints: 43200
                reducer: last
                refId: B
                type: reduce
            - refId: C
              relativeTimeRange:
                from: 3600
                to: 0
              datasourceUid: __expr__
              model:
                conditions:
                    - evaluator:
                        params:
                            - 0.5
                        type: gt
                      operator:
                        type: and
                      query:
                        params:
                            - C
                      reducer:
                        params: []
                        type: last
                      type: query
                datasource:
                    type: __expr__
                    uid: __expr__
                expression: B
                intervalMs: 1000
                maxDataPoints: 43200
                refId: C
                type: threshold
          dashboardUid: dotnet-application-metrics-main
          panelId: 3
          noDataState: Alerting
          execErrState: Error
          for: 1m
          annotations:
            __dashboardUid__: dotnet-application-metrics-main
            __panelId__: "3"
            description: Bir veya daha fazla Kubernetes deployment'ı spec.replicas > 0 olmasına rağmen 0 available replica'ya sahip, yani deployment down durumda.
            summary: '{{ $values.C }} deployment(s) 0 available replica''ya sahip'
          labels:
            severity: critical
            stack: eks-prod
          isPaused: false
        - uid: ffuycsha175dsb
          title: EKS PROD - CrashLoopBackOff
          condition: C
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: afl5b2ub9alfke
              model:
                editorMode: code
                expr: |-
                    count(
                      max by (namespace, pod, container) (
                        max_over_time(kube_pod_container_status_waiting_reason{reason="CrashLoopBackOff"}[5m])
                      ) > 0
                    ) or vector(0)
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
            - refId: C
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: __expr__
              model:
                conditions:
                    - evaluator:
                        params:
                            - 0
                        type: gt
                      operator:
                        type: and
                      query:
                        params:
                            - C
                      reducer:
                        params: []
                        type: last
                      type: query
                datasource:
                    type: __expr__
                    uid: __expr__
                expression: A
                intervalMs: 1000
                maxDataPoints: 43200
                refId: C
                type: threshold
          noDataState: Alerting
          execErrState: Alerting
          for: 5m
          annotations:
            description: 'Son 5 dk içinde CrashLoopBackOff''a giren container sayısı > 0 olduğunda tetiklenir. Kaynak: eks2 dashboard "CrashLoop" paneli (id 62).'
            summary: 'EKS PROD: {{ $values.A.Value }} container CrashLoopBackOff durumunda.'
          labels:
            cluster: eks-prod
            severity: critical
            team: sre
          isPaused: false
